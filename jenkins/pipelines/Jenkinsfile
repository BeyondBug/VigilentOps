// SecureGuard — Security Pipeline v5
// Child scanner containers need the host path of the Jenkins workspace volume.
// Set JENKINS_HOME_HOST for this server before enabling the ci profile.

pipeline {
    agent any

    options {
        timeout(time: 120, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'REPO_URL',   value: '$.repository.clone_url'],
                [key: 'BRANCH_REF', value: '$.ref'],
                [key: 'COMMIT_SHA', value: '$.after'],
                [key: 'PUSHER',     value: '$.pusher.login'],
                [key: 'REPO_NAME',  value: '$.repository.name'],
            ],
            token:           'secureguard-webhook-token',
            causeString:     'Triggered by $PUSHER pushing to $BRANCH_REF',
            printContributedVariables: false,
            printPostContent: false,
            silentResponse:  false,
            regexpFilterText:       '$BRANCH_REF',
            regexpFilterExpression: 'refs/heads/(main|develop|master)'
        )
    }

    environment {
        TARGET_REPO   = "${(env.REPO_URL ?: '').replace('localhost:3000', 'sg-gitea:3000').replace('http://gitea:3000', 'http://sg-gitea:3000')}"
        TARGET_BRANCH = "${env.BRANCH_REF ? env.BRANCH_REF.replace('refs/heads/', '') : 'main'}"
        COMMIT_SHA    = "${env.COMMIT_SHA ?: 'HEAD'}"
        REPO_FULLNAME = "${env.REPO_NAME ?: ''}"

        // Jenkins container path (what Jenkins itself sees)
        REPORTS_DIR   = "${WORKSPACE}/reports"
        SOURCE_DIR    = "${WORKSPACE}/target"

        // HOST path (what Docker child containers must use for -v mounts)
        GITEA_TOKEN   = credentials('gitea-cred')
        ORCHESTRATOR  = "http://sg-orchestrator:8000"
    }

    stages {

        stage('Prepare') {
            steps {
                script {
                    if (!env.TARGET_REPO?.trim()) error('REPO_URL is required')
                    if (!env.JENKINS_HOME_HOST?.trim()) error('JENKINS_HOME_HOST is required')
                    if (!env.REPO_FULLNAME?.trim()) env.REPO_FULLNAME = env.TARGET_REPO.tokenize('/').last().replace('.git', '')
                    echo "SecureGuard Scan #${BUILD_NUMBER} | ${REPO_FULLNAME} | ${COMMIT_SHA.take(8)}"
                    sh "mkdir -p ${REPORTS_DIR}"

                    // Compute HOST paths for Docker child containers
                    // WORKSPACE = /var/jenkins_home/workspace/secureguard-shadowpatch
                    // HOST_WS   = /var/lib/docker/volumes/.../workspace/secureguard-shadowpatch
                    def wsRelative = WORKSPACE.replace('/var/jenkins_home/', '')
                    env.HOST_SOURCE  = "${JENKINS_HOME_HOST}/${wsRelative}/target"
                    env.HOST_REPORTS = "${JENKINS_HOME_HOST}/${wsRelative}/reports"
                    env.HOST_RULES   = "${JENKINS_HOME_HOST}/${wsRelative}/scanners/semgrep-rules"
                    env.HOST_VALIDATOR = "${JENKINS_HOME_HOST}/${wsRelative}/scripts/validate_scan_reports.py"

                    echo "Container SOURCE : ${SOURCE_DIR}"
                    echo "Host SOURCE      : ${env.HOST_SOURCE}"
                    echo "Container REPORTS: ${REPORTS_DIR}"
                    echo "Host REPORTS     : ${env.HOST_REPORTS}"
                    echo "Host RULES       : ${env.HOST_RULES}"
                    if (sh(script: "test -f ${WORKSPACE}/scanners/semgrep-rules/secureguard-rules.yaml",
                           returnStatus: true) != 0) {
                        error('Shared Semgrep rules are missing from the pipeline checkout')
                    }
                    if (sh(script: "test -f ${WORKSPACE}/scripts/validate_scan_reports.py",
                           returnStatus: true) != 0) {
                        error('Shared report validator is missing from the pipeline checkout')
                    }

                }

                dir('target') {
                    git(url: env.TARGET_REPO, branch: "${TARGET_BRANCH}",
                        credentialsId: 'gitea-cred')
                }

                script {
                    def checkedOutCommit = sh(script: 'git -C target rev-parse HEAD',
                                              returnStdout: true).trim()
                    if (env.COMMIT_SHA != 'HEAD' &&
                        !checkedOutCommit.equalsIgnoreCase(env.COMMIT_SHA)) {
                        error("Webhook commit ${env.COMMIT_SHA} does not match checked out commit ${checkedOutCommit}")
                    }
                    env.COMMIT_SHA = checkedOutCommit
                    def body = groovy.json.JsonOutput.toJson([
                        repo_url: env.TARGET_REPO, commit_sha: env.COMMIT_SHA,
                        branch: env.TARGET_BRANCH, repo_name: env.REPO_FULLNAME,
                    ])
                    writeFile file: 'scan-payload.json', text: body
                    def resp = sh(script: '''set +x
                        curl -sf -X POST "$ORCHESTRATOR/api/scans" \\
                        -H "X-API-Key: $SG_API_KEY" \\
                        -H 'Content-Type: application/json' \\
                        --data-binary @scan-payload.json ''',
                        returnStdout: true).trim()
                    def scan = readJSON(text: resp)
                    if (!(scan.id instanceof Number) || scan.id <= 0) {
                        error('Orchestrator did not return a valid scan ID')
                    }
                    env.SCAN_RUN_ID = scan.id.toString()
                    echo "Scan run ID: ${env.SCAN_RUN_ID} | commit: ${env.COMMIT_SHA}"

                    env.HAS_PYTHON = sh(script: "find ${SOURCE_DIR} -name '*.py' | head -1",
                                        returnStdout: true).trim() ? "true" : "false"
                    env.HAS_REQS   = sh(script: "find ${SOURCE_DIR} -name 'requirements*.txt' | head -1",
                                        returnStdout: true).trim() ? "true" : "false"
                    echo "Python:${env.HAS_PYTHON} | Requirements:${env.HAS_REQS}"

                    // Verify host path is accessible by Docker
                    def hostCheck = sh(script: "docker run --rm -v ${env.HOST_SOURCE}:/check alpine ls /check | wc -l",
                                       returnStdout: true).trim()
                    echo "Files visible to Docker via host path: ${hostCheck}"
                }
            }
        }

        stage('Security Scan') {
            parallel {

                stage('Semgrep SAST') {
                    steps {
                        sh """
                            echo "Running Semgrep via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v ${env.HOST_RULES}:/shared-rules:ro \
                              returntocorp/semgrep:latest semgrep \
                                --config=/shared-rules \
                                --config=auto \
                                --sarif \
                                --output=/reports/semgrep.sarif \
                                --timeout=120 --max-memory=1024 --jobs=2 \
                                --no-git-ignore --skip-unknown-extensions \
                                /src 2>&1 | tail -10 || true

                            ls -lh ${REPORTS_DIR}/semgrep.sarif 2>/dev/null \
                              && echo "Semgrep OK — \$(wc -c < ${REPORTS_DIR}/semgrep.sarif) bytes" \
                              || echo "WARNING: semgrep no output"
                        """
                    }
                }

                stage('Bandit Python') {
                    when { expression { return env.HAS_PYTHON == "true" } }
                    steps {
                        sh """
                            echo "Running Bandit via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              python:3.12-slim bash -c "
                                pip install bandit -q --no-warn-script-location 2>/dev/null
                                bandit -r /src -f json -o /reports/bandit.json --exit-zero 2>&1 | tail -5
                                ls -lh /reports/bandit.json && echo 'Bandit wrote file' || echo 'Bandit no output'
                              " || true

                            ls -lh ${REPORTS_DIR}/bandit.json 2>/dev/null \
                              && echo "Bandit OK — \$(wc -c < ${REPORTS_DIR}/bandit.json) bytes" \
                              || echo "WARNING: bandit no output"
                        """
                    }
                }

                stage('Gitleaks Secrets') {
                    steps {
                        sh """
                            echo "Running Gitleaks via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              zricethezav/gitleaks:v8.18.2 detect \
                                --source=/src \
                                --report-format=sarif \
                                --report-path=/reports/gitleaks.sarif \
                                --no-git --exit-code=0 2>&1 || true

                            ls -lh ${REPORTS_DIR}/gitleaks.sarif 2>/dev/null \
                              && echo "Gitleaks OK — \$(wc -c < ${REPORTS_DIR}/gitleaks.sarif) bytes" \
                              || echo "WARNING: gitleaks no output"
                        """
                    }
                }

                stage('Trivy SCA') {
                    steps {
                        sh """
                            echo "Running Trivy via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v trivy-cache:/root/.cache/trivy \
                              aquasec/trivy:latest fs \
                                --format sarif \
                                --output /reports/trivy-deps.sarif \
                                --exit-code 0 \
                                --scanners vuln,secret \
                                --skip-version-check \
                                /src 2>&1 | tail -8 || true

                            ls -lh ${REPORTS_DIR}/trivy-deps.sarif 2>/dev/null \
                              && echo "Trivy OK — \$(wc -c < ${REPORTS_DIR}/trivy-deps.sarif) bytes" \
                              || echo "WARNING: trivy no output"
                        """
                    }
                }

                stage('Checkov IaC') {
                    steps {
                        sh """
                            echo "Running Checkov via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              bridgecrew/checkov:latest \
                                -d /src \
                                -o sarif > ${REPORTS_DIR}/checkov.sarif || true

                            ls -lh ${REPORTS_DIR}/checkov.sarif 2>/dev/null \
                              && echo "Checkov OK — \$(wc -c < ${REPORTS_DIR}/checkov.sarif) bytes" \
                              || echo "WARNING: checkov no output"
                        """
                    }
                }

                stage('Snyk SCA') {
                    steps {
                        sh """
                            set +x
                            echo "Running Snyk via HOST path: ${env.HOST_SOURCE}"
                            if [ -z "\${SNYK_TOKEN}" ]; then
                                echo "WARNING: SNYK_TOKEN not set, skipping."
                                exit 0
                            fi
                            docker run --rm \
                              -e SNYK_TOKEN \
                              -v ${env.HOST_SOURCE}:/src \
                              snyk/snyk:linux test --sarif --all-projects > ${REPORTS_DIR}/snyk.sarif || true

                            test -s ${REPORTS_DIR}/snyk.sarif || {
                                echo "ERROR: Snyk produced no SARIF report"
                                exit 1
                            }
                            echo "Snyk OK — \$(wc -c < ${REPORTS_DIR}/snyk.sarif) bytes"
                        """
                        script {
                            if (env.SNYK_TOKEN?.trim()) {
                                def report = readJSON file: "${REPORTS_DIR}/snyk.sarif"
                                if (report.version != '2.1.0' || report.runs == null) {
                                    error('Snyk report is not valid SARIF')
                                }
                            }
                        }
                    }
                }

                stage('Container Image Scans') {
                    steps {
                        sh """
                            echo "Building and scanning the first target Dockerfile"
                            DOCKERFILE=\$(find ${SOURCE_DIR} -name Dockerfile -print -quit)
                            if [ -n "\$DOCKERFILE" ]; then
                                DIR=\$(dirname "\$DOCKERFILE")
                                if docker build -t sg-target-scan:${BUILD_NUMBER} "\$DIR"; then
                                    touch ${REPORTS_DIR}/image-built.marker
                                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v ${env.HOST_REPORTS}:/reports goodwithtech/dockle:latest -f sarif -o /reports/dockle.sarif sg-target-scan:${BUILD_NUMBER} || true
                                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v ${env.HOST_REPORTS}:/reports aquasec/trivy:latest image --format sarif --output /reports/trivy-image.sarif sg-target-scan:${BUILD_NUMBER} || true
                                else
                                    echo "WARNING: target image build failed; image scanners skipped"
                                fi
                            else
                                echo "No Dockerfile found; image scanners skipped"
                            fi

                            ls -lh ${REPORTS_DIR}/dockle.sarif 2>/dev/null \
                              && echo "Dockle OK" || echo "WARNING: dockle no output"
                            ls -lh ${REPORTS_DIR}/trivy-image.sarif 2>/dev/null \
                              && echo "Trivy Image OK" || echo "WARNING: Trivy Image no output"
                        """
                    }
                }

                stage('Dep-Check SCA') {
                    steps {
                        sh """
                            set +x
                            echo "Running Dep-Check via HOST path: ${env.HOST_SOURCE}"
                            if [ -n "\${NVD_API_KEY:-}" ]; then
                                set -- --nvdApiKey "\$NVD_API_KEY"
                            else
                                set --
                            fi
                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v depcheck-cache:/usr/share/dependency-check/data \
                              owasp/dependency-check:latest \
                                "\$@" \
                                --scan /src \
                                --format SARIF \
                                --out /reports/dep-check.sarif

                            test -s ${REPORTS_DIR}/dep-check.sarif || {
                                echo "ERROR: Dependency-Check produced no SARIF report"
                                exit 1
                            }
                            echo "Dep-Check OK — \$(wc -c < ${REPORTS_DIR}/dep-check.sarif) bytes"
                        """
                        script {
                            def report = readJSON file: "${REPORTS_DIR}/dep-check.sarif"
                            if (report.version != '2.1.0' || report.runs == null) {
                                error('Dependency-Check report is not valid SARIF')
                            }
                        }
                    }
                }

                stage('Grype SCA') {
                    steps {
                        sh """
                            echo "Running Grype via HOST path: ${env.HOST_SOURCE}"
                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v grype-cache:/grype-db \
                              -e GRYPE_DB_CACHE_DIR=/grype-db \
                              -e GRYPE_CHECK_FOR_APP_UPDATE=false \
                              -e GRYPE_DB_UPDATE_AVAILABLE_TIMEOUT=20s \
                              -e GRYPE_DB_UPDATE_DOWNLOAD_TIMEOUT=3m \
                              anchore/grype:latest \
                                dir:/src \
                                -o sarif > ${REPORTS_DIR}/grype.sarif || true

                            ls -lh ${REPORTS_DIR}/grype.sarif 2>/dev/null \
                              && echo "Grype OK — \$(wc -c < ${REPORTS_DIR}/grype.sarif) bytes" \
                              || echo "WARNING: grype no output"
                        """
                    }
                }

                stage('OSV SCA') {
                    steps {
                        sh """
                            echo "Running OSV-Scanner against supported lockfiles and manifests"
                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              ghcr.io/google/osv-scanner:v2.4.0 \
                                scan source --recursive --format sarif \
                                --output-file /reports/osv.sarif /src || true

                            ls -lh ${REPORTS_DIR}/osv.sarif 2>/dev/null \
                              && echo "OSV OK — \$(wc -c < ${REPORTS_DIR}/osv.sarif) bytes" \
                              || echo "WARNING: osv no output"
                        """
                    }
                }

                stage('Syft SBOM') {
                    steps {
                        sh """
                            echo "Running Syft SBOM Generator via HOST path: ${env.HOST_SOURCE}"
                            docker run --rm -v ${env.HOST_SOURCE}:/src -v ${env.HOST_REPORTS}:/reports anchore/syft:latest dir:/src -o spdx-json=/reports/syft-sbom.json || true
                            ls -lh ${REPORTS_DIR}/syft-sbom.json 2>/dev/null && echo "Syft OK" || echo "WARNING: Syft no output"
                        """
                    }
                }


            }
        }

        stage('Validate Reports') {
            steps {
                script {
                    def pythonFlag = env.HAS_PYTHON == 'true' ? '--python' : ''
                    def snykFlag = env.SNYK_TOKEN?.trim() ? '--snyk' : ''
                    sh "docker run --rm -v ${env.HOST_REPORTS}:/reports:ro -v ${env.HOST_VALIDATOR}:/validator.py:ro python:3.12-slim python /validator.py /reports ${pythonFlag} ${snykFlag}"
                }
            }
        }

        stage('Upload Reports') {
            steps {
                echo "=== Reports ==="
                sh "ls -lh ${REPORTS_DIR}/ || echo 'empty'"
                sh """
                    set +x
                    set -eu
                    UPLOADED=0
                    for f in ${REPORTS_DIR}/*.sarif ${REPORTS_DIR}/*.json; do
                        [ -s "\$f" ] || continue
                        TOOL=\$(basename \$f | sed 's/\\.sarif//;s/\\.json//')
                        SIZE=\$(wc -c < "\$f")
                        echo "  Uploading \$TOOL (\$SIZE bytes)..."
                        CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                          -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/reports/\$TOOL \
                          -H 'X-API-Key: ${SG_API_KEY}' \
                          -H 'Content-Type: application/json' \
                          --data-binary @\$f) || CODE=000
                        echo "  -> HTTP \$CODE"
                        case "\$CODE" in
                            200|201) ;;
                            *) echo "ERROR: report upload failed for \$TOOL"; exit 1 ;;
                        esac
                        UPLOADED=\$((UPLOADED+1))
                    done
                    echo "Uploaded: \$UPLOADED files"
                """
            }
        }

        stage('CVE Enrichment') {
            steps {
                sh """
                    set +x
                    set -e
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/enrich \
                      -H 'X-API-Key: ${SG_API_KEY}' \
                      -H 'Content-Type: application/json' -d '{}' \
                      -o /tmp/enrich_resp.json
                    cat /tmp/enrich_resp.json
                """
            }
        }

        stage('AI Auto-Remediation') {
            steps {
                sh """
                    set +x
                    set -e
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/fix \
                      -H 'X-API-Key: ${SG_API_KEY}' \
                      -H 'Content-Type: application/json' \
                      -d '{}' \
                      -o /tmp/fix_resp.json
                    cat /tmp/fix_resp.json
                """
            }
        }

        stage('Notify') {
            steps {
                sh """
                    set +x
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/notify \
                      -H 'X-API-Key: ${SG_API_KEY}' \
                      -H 'Content-Type: application/json' \
                      -d '{"build_url":"${env.BUILD_URL}"}' || true
                    echo "Done — Scan #${env.SCAN_RUN_ID}"
                """
            }
        }

    }

    post {
        always {
            sh "ls -lh ${REPORTS_DIR}/ 2>/dev/null || true"
            sh "docker rmi sg-target-scan:${BUILD_NUMBER} 2>/dev/null || true"
            cleanWs()
        }
        success {
            sh "set +x\ncurl --retry 3 -sf -X PATCH ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID} -H 'X-API-Key: ${SG_API_KEY}' -H 'Content-Type: application/json' -d '{\"status\":\"complete\"}'"
        }
        failure {
            script {
                if (env.SCAN_RUN_ID?.trim()) {
                    sh "set +x\ncurl -sf -X PATCH ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID} -H 'X-API-Key: ${SG_API_KEY}' -H 'Content-Type: application/json' -d '{\"status\":\"failed\"}' || true"
                }
            }
        }
    }
}
