// SecureGuard — Security Pipeline v5
// Child scanner containers need the host path of the Jenkins workspace volume.
// Set JENKINS_HOME_HOST for this server before enabling the ci profile.

pipeline {
    agent any

    options {
        timeout(time: 120, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'REVIEW_AI_PR', defaultValue: false, description: 'Administrator-requested scan of an AI PR head; no new AI task is queued')
        string(name: 'REVIEW_REPO_URL', defaultValue: '', description: 'Configured Gitea clone URL')
        string(name: 'REVIEW_BRANCH', defaultValue: '', description: 'secureguard/scan-N-fixes PR branch')
        string(name: 'REVIEW_COMMIT_SHA', defaultValue: '', description: 'Exact 40-character PR head commit')
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'REPO_URL',   value: '$.repository.clone_url'],
                [key: 'BRANCH_REF', value: '$.ref'],
                [key: 'COMMIT_SHA', value: '$.after'],
                [key: 'PUSHER',     value: '$.pusher.login'],
                [key: 'REPO_NAME',  value: '$.repository.name'],
            ],
            tokenCredentialId: 'gitea-webhook-token',
            causeString:     'Triggered by $PUSHER pushing to $BRANCH_REF',
            printContributedVariables: false,
            printPostContent: false,
            silentResponse:  false,
            regexpFilterText:       '$BRANCH_REF',
            regexpFilterExpression: '^refs/heads/(main|develop|master)$'
        )
    }

    environment {
        TARGET_BRANCH = "${params.REVIEW_AI_PR ? params.REVIEW_BRANCH : (env.BRANCH_REF ? env.BRANCH_REF.replace('refs/heads/', '') : 'main')}"
        COMMIT_SHA    = "${params.REVIEW_AI_PR ? params.REVIEW_COMMIT_SHA : (env.COMMIT_SHA ?: 'HEAD')}"

        // Jenkins container path (what Jenkins itself sees)
        REPORTS_DIR   = "${WORKSPACE}/reports"
        SOURCE_DIR    = "${WORKSPACE}/target"

        // HOST path (what Docker child containers must use for -v mounts)
        GITEA_TOKEN   = credentials('gitea-cred')
        ORCHESTRATOR  = "http://sg-orchestrator:8000"
    }

    stages {

        stage('Prepare') {
            steps {
                script {
                    def requestedRepo = (params.REVIEW_AI_PR ? params.REVIEW_REPO_URL : (env.REPO_URL ?: '')).trim()
                    if (!requestedRepo) error('REPO_URL is required')
                    def reviewBranch = params.REVIEW_AI_PR && (env.TARGET_BRANCH ==~ /^secureguard\/scan-[0-9]+-fixes$/)
                    if (!(env.TARGET_BRANCH in ['main', 'develop', 'master']) && !reviewBranch) {
                        error('Webhook branch is not accepted for scanning')
                    }
                    if (params.REVIEW_AI_PR && !reviewBranch) error('AI review requires an explicit SecureGuard PR branch')
                    if (params.REVIEW_AI_PR && !(env.COMMIT_SHA ==~ /^[0-9a-fA-F]{40}$/)) {
                        error('AI review requires the exact PR head commit')
                    }
                    if (env.COMMIT_SHA != 'HEAD' && !(env.COMMIT_SHA ==~ /^[0-9a-fA-F]{40}$/)) {
                        error('Webhook commit must be a full Git SHA')
                    }
                    // Match a full configured origin before replacing it. A
                    // public hostname or HTTPS URL must not become an SSRF path.
                    def allowedOrigins = ['http://sg-gitea:3000', 'http://gitea:3000',
                                          'http://localhost:3000',
                                          (env.GITEA_PUBLIC_URL ?: '').replaceAll('/+$', '')]
                    def origin = allowedOrigins.find { it && requestedRepo.startsWith(it + '/') }
                    if (!origin) error('Webhook repository origin is not configured for Gitea')
                    env.TARGET_REPO = 'http://sg-gitea:3000' + requestedRepo.substring(origin.length())
                    if (!(env.TARGET_REPO ==~ /^http:\/\/sg-gitea:3000\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+\.git$/)) {
                        error('Webhook repository URL must be a Gitea clone URL on sg-gitea:3000')
                    }
                    if (!env.JENKINS_HOME_HOST?.trim()) error('JENKINS_HOME_HOST is required')
                    def components = env.TARGET_REPO.substring('http://sg-gitea:3000/'.length()).tokenize('/')
                    if (components[0] in ['.', '..'] || components[1].replaceAll(/\.git$/, '') in ['', '.', '..']) {
                        error('Webhook repository path is invalid')
                    }
                    env.REPO_FULLNAME = components[1].replaceAll(/\.git$/, '')
                    echo "SecureGuard Scan #${BUILD_NUMBER} | ${REPO_FULLNAME} | ${COMMIT_SHA.take(8)}"
                    sh """mkdir -p ${REPORTS_DIR}
                        rm -f ${REPORTS_DIR}/*.sarif ${REPORTS_DIR}/*.json ${REPORTS_DIR}/image-built.marker ${REPORTS_DIR}/.nvd.properties
                    """

                    // Compute HOST paths for Docker child containers
                    // WORKSPACE = /var/jenkins_home/workspace/secureguard-shadowpatch
                    // HOST_WS   = /var/lib/docker/volumes/.../workspace/secureguard-shadowpatch
                    def wsRelative = WORKSPACE.replace('/var/jenkins_home/', '')
                    env.HOST_SOURCE  = "${JENKINS_HOME_HOST}/${wsRelative}/target"
                    env.HOST_REPORTS = "${JENKINS_HOME_HOST}/${wsRelative}/reports"
                    env.HOST_RULES   = "${JENKINS_HOME_HOST}/${wsRelative}/scanners/semgrep-rules"
                    env.HOST_VALIDATOR = "${JENKINS_HOME_HOST}/${wsRelative}/scripts/validate_scan_reports.py"
                    env.HOST_LINT_POLICY = "${JENKINS_HOME_HOST}/${wsRelative}/scanners/static-analysis/hadolint.yaml"
                    env.DEPCHECK_FIXTURE_EXCLUDE = ''
                    if (env.TARGET_REPO == 'http://sg-gitea:3000/BeyondBug/sietlms-moodle-.git') {
                        // Deliberately malformed/encrypted archive test data,
                        // not deployed dependencies. Keep all other files scanned.
                        env.DEPCHECK_FIXTURE_EXCLUDE = '/src/public/lib/filestorage/tests/fixtures/*.zip'
                        echo 'Dependency-Check excludes only Moodle filestorage ZIP test fixtures'
                    }

                    echo "Container SOURCE : ${SOURCE_DIR}"
                    echo "Host SOURCE      : ${env.HOST_SOURCE}"
                    echo "Container REPORTS: ${REPORTS_DIR}"
                    echo "Host REPORTS     : ${env.HOST_REPORTS}"
                    echo "Host RULES       : ${env.HOST_RULES}"
                    if (sh(script: "test -f ${WORKSPACE}/scanners/semgrep-rules/secureguard-rules.yaml",
                           returnStatus: true) != 0) {
                        error('Shared Semgrep rules are missing from the pipeline checkout')
                    }
                    if (sh(script: "test -f ${WORKSPACE}/scripts/validate_scan_reports.py",
                           returnStatus: true) != 0) {
                        error('Shared report validator is missing from the pipeline checkout')
                    }

                }

                dir('target') {
                    // A restarted/aborted job can leave files from another repo.
                    deleteDir()
                    git(url: env.TARGET_REPO, branch: "${TARGET_BRANCH}",
                        credentialsId: 'gitea-cred')
                }

                script {
                    def checkedOutCommit = sh(script: 'git -C target rev-parse HEAD',
                                              returnStdout: true).trim()
                    if (env.COMMIT_SHA != 'HEAD' &&
                        !checkedOutCommit.equalsIgnoreCase(env.COMMIT_SHA)) {
                        error("Webhook commit ${env.COMMIT_SHA} does not match checked out commit ${checkedOutCommit}")
                    }
                    env.COMMIT_SHA = checkedOutCommit
                    env.HAS_PYTHON = sh(script: "find ${SOURCE_DIR} -name '*.py' -print -quit",
                                        returnStdout: true).trim() ? "true" : "false"
                    def requiredReports = ['semgrep', 'gitleaks', 'trivy-deps', 'grype', 'osv', 'dep-check', 'syft-sbom', 'hadolint', 'shellcheck']
                    if (env.HAS_PYTHON == 'true') requiredReports.add('bandit')
                    if (env.SNYK_TOKEN?.trim()) requiredReports.add('snyk')
                    env.REQUIRED_REPORTS = groovy.json.JsonOutput.toJson(requiredReports)
                    def pipelineCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    def body = groovy.json.JsonOutput.toJson([
                        repo_url: env.TARGET_REPO, commit_sha: checkedOutCommit,
                        branch: env.TARGET_BRANCH, repo_name: env.REPO_FULLNAME,
                        required_reports: requiredReports,
                        pipeline_commit: pipelineCommit,
                    ])
                    writeFile file: 'scan-payload.json', text: body
                    def resp = sh(script: '''set +x
                        curl -sf -X POST "$ORCHESTRATOR/api/scans" \\
                        -H "X-API-Key: $SG_API_KEY" \\
                        -H 'Content-Type: application/json' \\
                        --data-binary @scan-payload.json ''',
                        returnStdout: true).trim()
                    def scan = readJSON(text: resp)
                    if (!(scan.id instanceof Number) || scan.id <= 0) {
                        error('Orchestrator did not return a valid scan ID')
                    }
                    env.SCAN_RUN_ID = scan.id.toString()
                    echo "Scan run ID: ${env.SCAN_RUN_ID} | commit: ${env.COMMIT_SHA}"

                    env.HAS_REQS   = sh(script: "find ${SOURCE_DIR} -name 'requirements*.txt' | head -1",
                                        returnStdout: true).trim() ? "true" : "false"
                    echo "Python:${env.HAS_PYTHON} | Requirements:${env.HAS_REQS}"

                    // Bind mounts must contain the same checkout, not an
                    // empty directory silently created by Docker's -v option.
                    def hostCommit = sh(script: '''set -eu
                        IMAGE_ID=$(docker inspect --format '{{.Image}}' sg-jenkins)
                        docker run --rm --network none --read-only --user 0 \\
                          --mount "type=bind,source=$HOST_SOURCE,target=/check,readonly" \\
                          --entrypoint git "$IMAGE_ID" -c safe.directory=/check -C /check rev-parse HEAD
                    ''', returnStdout: true).trim()
                    if (!hostCommit.equalsIgnoreCase(checkedOutCommit)) {
                        error('Docker scanner mount does not match the checked out target commit')
                    }
                    echo "Docker mount verified at ${hostCommit.take(12)}"

                }
            }
        }

        stage('Update Trivy Database') {
            steps {
                sh """
                    docker run --rm \
                      -v trivy-cache:/root/.cache/trivy \
                      aquasec/trivy:latest image \
                        --download-db-only \
                        --timeout 25m \
                        --db-repository docker.io/aquasec/trivy-db \
                        --db-repository public.ecr.aws/aquasecurity/trivy-db \
                        --db-repository ghcr.io/aquasecurity/trivy-db
                """
            }
        }

        stage('Security Scan') {
            parallel {

                stage('Dockerfile and Shell Lint') {
                    options { timeout(time: 20, unit: 'MINUTES') }
                    steps {
                        sh '''set -eu
                            python3 scripts/run_static_scans.py --source "$SOURCE_DIR" \\
                              --host-source "$HOST_SOURCE" --host-policy "$HOST_LINT_POLICY" \\
                              --reports "$REPORTS_DIR"
                        '''
                    }
                }

                stage('Semgrep SAST') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Semgrep via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v ${env.HOST_RULES}:/shared-rules:ro \
                              returntocorp/semgrep:latest semgrep \
                                --config=/shared-rules \
                                --config=auto \
                                --sarif \
                                --output=/reports/semgrep.sarif \
                                --timeout=120 --max-memory=1024 --jobs=2 \
                                --no-git-ignore --skip-unknown-extensions \
                                /src > ${WORKSPACE}/semgrep-execution.log 2>&1

                            ls -lh ${REPORTS_DIR}/semgrep.sarif 2>/dev/null \
                              && echo "Semgrep OK — \$(wc -c < ${REPORTS_DIR}/semgrep.sarif) bytes" \
                              || echo "WARNING: semgrep no output"
                        """
                    }
                }

                stage('Bandit Python') {
                    when { expression { return env.HAS_PYTHON == "true" } }
                    steps {
                        sh """
                            set -eu
                            echo "Running Bandit via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              python:3.12-slim bash -ec "
                                pip install bandit==1.9.4 -q --no-warn-script-location
                                bandit -r /src -f json -o /reports/bandit.json --exit-zero
                                test -s /reports/bandit.json
                              "

                            ls -lh ${REPORTS_DIR}/bandit.json 2>/dev/null \
                              && echo "Bandit OK — \$(wc -c < ${REPORTS_DIR}/bandit.json) bytes" \
                              || echo "WARNING: bandit no output"
                        """
                    }
                }

                stage('Gitleaks Secrets') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Gitleaks via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              zricethezav/gitleaks:v8.18.2 detect \
                                --source=/src \
                                --report-format=sarif \
                                --report-path=/reports/gitleaks.sarif \
                                --no-git --exit-code=0 > ${WORKSPACE}/gitleaks-execution.log 2>&1

                            ls -lh ${REPORTS_DIR}/gitleaks.sarif 2>/dev/null \
                              && echo "Gitleaks OK — \$(wc -c < ${REPORTS_DIR}/gitleaks.sarif) bytes" \
                              || echo "WARNING: gitleaks no output"
                        """
                    }
                }

                stage('Trivy SCA') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Trivy via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v trivy-cache:/root/.cache/trivy \
                              aquasec/trivy:latest fs \
                                --timeout 25m \
                                --skip-db-update \
                                --format sarif \
                                --output /reports/trivy-deps.sarif \
                                --exit-code 0 \
                                --scanners vuln,secret \
                                --skip-version-check \
                                /src > ${WORKSPACE}/trivy-execution.log 2>&1

                            ls -lh ${REPORTS_DIR}/trivy-deps.sarif 2>/dev/null \
                              && echo "Trivy OK — \$(wc -c < ${REPORTS_DIR}/trivy-deps.sarif) bytes" \
                              || echo "WARNING: trivy no output"
                        """
                    }
                }

                stage('Checkov IaC') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Checkov via HOST path: ${env.HOST_SOURCE}"

                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              bridgecrew/checkov:latest \
                                -d /src \
                                -o sarif \
                                --soft-fail --output-file-path /reports > ${WORKSPACE}/checkov-execution.log 2>&1

                            if [ -s ${REPORTS_DIR}/results_sarif.sarif ]; then
                                mv ${REPORTS_DIR}/results_sarif.sarif ${REPORTS_DIR}/checkov.sarif
                            fi

                            ls -lh ${REPORTS_DIR}/checkov.sarif 2>/dev/null \
                              && echo "Checkov OK — \$(wc -c < ${REPORTS_DIR}/checkov.sarif) bytes" \
                              || echo "WARNING: checkov no output"
                        """
                    }
                }

                stage('Snyk SCA') {
                    steps {
                        sh """
                            set +x
                            echo "Running Snyk via HOST path: ${env.HOST_SOURCE}"
                            if [ -z "\${SNYK_TOKEN}" ]; then
                                echo "WARNING: SNYK_TOKEN not set, skipping."
                                exit 0
                            fi
                            SNYK_EXIT=0
                            docker run --rm \
                              -e SNYK_TOKEN \
                              -v ${env.HOST_SOURCE}:/src \
                              snyk/snyk:linux test --sarif --all-projects --fail-fast > ${REPORTS_DIR}/snyk.sarif || SNYK_EXIT=\$?
                            case "\$SNYK_EXIT" in
                                0|1) ;;
                                *) echo "ERROR: Snyk execution failed (exit \$SNYK_EXIT)"; exit 1 ;;
                            esac

                            test -s ${REPORTS_DIR}/snyk.sarif || {
                                echo "ERROR: Snyk produced no SARIF report"
                                exit 1
                            }
                            echo "Snyk OK — \$(wc -c < ${REPORTS_DIR}/snyk.sarif) bytes"
                        """
                        script {
                            if (env.SNYK_TOKEN?.trim()) {
                                def report = readJSON file: "${REPORTS_DIR}/snyk.sarif"
                                if (report.version != '2.1.0' || report.runs == null) {
                                    error('Snyk report is not valid SARIF')
                                }
                            }
                        }
                    }
                }

                stage('Container Image Scans') {
                    steps {
                        sh """
                            set -eu
                            echo "Building and scanning the first target Dockerfile"
                            DOCKERFILE=\$(find ${SOURCE_DIR} -name Dockerfile -print -quit)
                            if [ -n "\$DOCKERFILE" ]; then
                                DIR=\$(dirname "\$DOCKERFILE")
                                if docker build -t sg-target-scan:${BUILD_NUMBER} "\$DIR"; then
                                    touch ${REPORTS_DIR}/image-built.marker
                                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v ${env.HOST_REPORTS}:/reports goodwithtech/dockle:latest -f sarif -o /reports/dockle.sarif sg-target-scan:${BUILD_NUMBER}
                                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v ${env.HOST_REPORTS}:/reports -v trivy-cache:/root/.cache/trivy aquasec/trivy:latest image --timeout 30m --skip-db-update --cache-backend memory --format sarif --output /reports/trivy-image.sarif sg-target-scan:${BUILD_NUMBER}
                                else
                                    echo "WARNING: target image build failed; image scanners skipped"
                                fi
                            else
                                echo "No Dockerfile found; image scanners skipped"
                            fi

                            ls -lh ${REPORTS_DIR}/dockle.sarif 2>/dev/null \
                              && echo "Dockle OK" || echo "WARNING: dockle no output"
                            ls -lh ${REPORTS_DIR}/trivy-image.sarif 2>/dev/null \
                              && echo "Trivy Image OK" || echo "WARNING: Trivy Image no output"
                        """
                    }
                }

                stage('Dep-Check SCA') {
                    steps {
                        sh """
                            set +x
                            set -eu
                            echo "Running Dep-Check via HOST path: ${env.HOST_SOURCE}"
                            if [ -n "\${NVD_API_KEY:-}" ]; then
                                umask 077
                                NVD_PROPS="${REPORTS_DIR}/.nvd.properties"
                                trap 'rm -f "\$NVD_PROPS"' EXIT
                                printf 'nvd.api.key=%s\\n' "\$NVD_API_KEY" > "\$NVD_PROPS"
                                chown 1000:1000 "\$NVD_PROPS"
                                set -- --propertyfile /reports/.nvd.properties
                            else
                                set --
                            fi
                            if [ -n "\${NVD_DATAFEED_URL:-}" ]; then
                                case "\$NVD_DATAFEED_URL" in
                                    https://*|http://*) ;;
                                    *) echo "ERROR: NVD_DATAFEED_URL must be an HTTP(S) URL"; exit 1 ;;
                                esac
                                set -- "\$@" --nvdDatafeed "\$NVD_DATAFEED_URL"
                            fi
                            if [ -n "\${DEPCHECK_FIXTURE_EXCLUDE:-}" ]; then
                                set -- "\$@" --exclude "\$DEPCHECK_FIXTURE_EXCLUDE"
                            fi
                            # The scanner runs as UID 1000; Jenkins creates the
                            # report directory as root in the mounted workspace.
                            chown 1000:1000 ${REPORTS_DIR}
                            DOCKER_DNS_ARGS=""
                            if [ -n "\${SCANNER_DNS:-}" ]; then
                                case "\$SCANNER_DNS" in
                                    *[!0-9a-fA-F.:]*) echo "ERROR: SCANNER_DNS must be an IP address"; exit 1 ;;
                                esac
                                DOCKER_DNS_ARGS="--dns=\$SCANNER_DNS"
                            fi
                            docker run --rm \
                              \$DOCKER_DNS_ARGS \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v depcheck-cache:/usr/share/dependency-check/data \
                              owasp/dependency-check:latest \
                                "\$@" \
                                --scan /src \
                                --format SARIF \
                                --out /reports/dep-check.sarif

                            test -s ${REPORTS_DIR}/dep-check.sarif || {
                                echo "ERROR: Dependency-Check produced no SARIF report"
                                exit 1
                            }
                            echo "Dep-Check OK — \$(wc -c < ${REPORTS_DIR}/dep-check.sarif) bytes"
                        """
                        script {
                            def report = readJSON file: "${REPORTS_DIR}/dep-check.sarif"
                            if (report.version != '2.1.0' || report.runs == null) {
                                error('Dependency-Check report is not valid SARIF')
                            }
                        }
                    }
                }

                stage('Grype SCA') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Grype via HOST path: ${env.HOST_SOURCE}"
                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              -v grype-cache:/grype-db \
                              -e GRYPE_DB_CACHE_DIR=/grype-db \
                              -e GRYPE_CHECK_FOR_APP_UPDATE=false \
                              -e GRYPE_DB_UPDATE_AVAILABLE_TIMEOUT=20s \
                              -e GRYPE_DB_UPDATE_DOWNLOAD_TIMEOUT=3m \
                              anchore/grype:latest \
                                dir:/src \
                                -o sarif > ${REPORTS_DIR}/grype.sarif

                            ls -lh ${REPORTS_DIR}/grype.sarif 2>/dev/null \
                              && echo "Grype OK — \$(wc -c < ${REPORTS_DIR}/grype.sarif) bytes" \
                              || echo "WARNING: grype no output"
                        """
                    }
                }

                stage('OSV SCA') {
                    steps {
                        sh """
                            set -eu
                            echo "Running OSV-Scanner against supported lockfiles and manifests"
                            OSV_EXIT=0
                            docker run --rm \
                              -v ${env.HOST_SOURCE}:/src \
                              -v ${env.HOST_REPORTS}:/reports \
                              ghcr.io/google/osv-scanner:v2.4.0 \
                                scan source --recursive --format sarif \
                                --output-file /reports/osv.sarif /src || OSV_EXIT=\$?
                            docker run --rm -v ${env.HOST_REPORTS}:/reports \
                              -v ${env.HOST_VALIDATOR}:/validator.py:ro \
                              python:3.12-slim python /validator.py /reports \
                                --normalize-osv-exit-code "\$OSV_EXIT"

                            ls -lh ${REPORTS_DIR}/osv.sarif 2>/dev/null \
                              && echo "OSV OK — \$(wc -c < ${REPORTS_DIR}/osv.sarif) bytes" \
                              || echo "WARNING: osv no output"
                        """
                    }
                }

                stage('Syft SBOM') {
                    steps {
                        sh """
                            set -eu
                            echo "Running Syft SBOM Generator via HOST path: ${env.HOST_SOURCE}"
                            docker run --rm -v ${env.HOST_SOURCE}:/src -v ${env.HOST_REPORTS}:/reports anchore/syft:latest dir:/src -o spdx-json=/reports/syft-sbom.json
                            ls -lh ${REPORTS_DIR}/syft-sbom.json 2>/dev/null && echo "Syft OK" || echo "WARNING: Syft no output"
                        """
                    }
                }


            }
        }

        stage('Validate Reports') {
            steps {
                script {
                    def pythonFlag = env.HAS_PYTHON == 'true' ? '--python' : ''
                    def snykFlag = env.SNYK_TOKEN?.trim() ? '--snyk' : ''
                    sh "docker run --rm -v ${env.HOST_REPORTS}:/reports:ro -v ${env.HOST_VALIDATOR}:/validator.py:ro python:3.12-slim python /validator.py /reports ${pythonFlag} ${snykFlag}"
                    def requiredReports = readJSON(text: env.REQUIRED_REPORTS)
                    if (fileExists("${REPORTS_DIR}/image-built.marker")) {
                        requiredReports.addAll(['dockle', 'trivy-image'])
                    }
                    writeFile file: 'report-contract.json', text: groovy.json.JsonOutput.toJson([required_reports: requiredReports])
                    sh '''set +x
                        curl -sf -X PATCH "$ORCHESTRATOR/api/scans/$SCAN_RUN_ID" \\
                          -H "X-API-Key: $SG_API_KEY" -H 'Content-Type: application/json' \\
                          --data-binary @report-contract.json
                    '''
                }
            }
        }

        stage('Upload Reports') {
            steps {
                echo "=== Reports ==="
                sh "ls -lh ${REPORTS_DIR}/ || echo 'empty'"
                sh """
                    set +x
                    set -eu
                    UPLOADED=0
                    for f in ${REPORTS_DIR}/*.sarif ${REPORTS_DIR}/*.json; do
                        [ -s "\$f" ] || continue
                        TOOL=\$(basename \$f | sed 's/\\.sarif//;s/\\.json//')
                        SIZE=\$(wc -c < "\$f")
                        echo "  Uploading \$TOOL (\$SIZE bytes)..."
                        CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                          -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/reports/\$TOOL \
                          -H "X-API-Key: \$SG_API_KEY" \
                          -H 'Content-Type: application/json' \
                          --data-binary @\$f) || CODE=000
                        echo "  -> HTTP \$CODE"
                        case "\$CODE" in
                            200|201) ;;
                            *) echo "ERROR: report upload failed for \$TOOL"; exit 1 ;;
                        esac
                        UPLOADED=\$((UPLOADED+1))
                    done
                    echo "Uploaded: \$UPLOADED files"
                """
            }
        }

        stage('CVE Enrichment') {
            steps {
                sh """
                    set +x
                    set -e
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/enrich \
                      -H "X-API-Key: \$SG_API_KEY" \
                      -H 'Content-Type: application/json' -d '{}' \
                      -o /tmp/enrich_resp.json
                    cat /tmp/enrich_resp.json
                """
            }
        }

        stage('AI Auto-Remediation') {
            when { expression { return !params.REVIEW_AI_PR } }
            steps {
                sh """
                    set +x
                    set -e
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/fix \
                      -H "X-API-Key: \$SG_API_KEY" \
                      -H 'Content-Type: application/json' \
                      -d '{}' \
                      -o /tmp/fix_resp.json
                    cat /tmp/fix_resp.json
                """
            }
        }

        stage('Notify') {
            steps {
                sh """
                    set +x
                    curl -sf -X POST ${ORCHESTRATOR}/api/scans/${env.SCAN_RUN_ID}/notify \
                      -H "X-API-Key: \$SG_API_KEY" \
                      -H 'Content-Type: application/json' \
                      -d '{"build_url":"${env.BUILD_URL}"}' || true
                    echo "Done — Scan #${env.SCAN_RUN_ID}"
                """
            }
        }

    }

    post {
        always {
            sh "ls -lh ${REPORTS_DIR}/ 2>/dev/null || true"
            sh '''set +x
                rm -f "$REPORTS_DIR/.nvd.properties"
                docker ps -aq --filter "label=secureguard.static-scan=true" \\
                  --filter "label=secureguard.build=$BUILD_TAG" | xargs -r docker rm -f
            '''
            sh "docker rmi sg-target-scan:${BUILD_NUMBER} 2>/dev/null || true"
            cleanWs()
        }
        success {
            sh '''set +x
                curl --retry 3 -sf -X PATCH "$ORCHESTRATOR/api/scans/$SCAN_RUN_ID" \\
                  -H "X-API-Key: $SG_API_KEY" -H 'Content-Type: application/json' -d '{"status":"complete"}'
            '''
        }
        failure {
            script {
                if (env.SCAN_RUN_ID?.trim()) {
                    sh '''set +x
                        curl -sf -X PATCH "$ORCHESTRATOR/api/scans/$SCAN_RUN_ID" \\
                          -H "X-API-Key: $SG_API_KEY" -H 'Content-Type: application/json' -d '{"status":"failed"}' || true
                    '''
                }
            }
        }
        aborted {
            script {
                if (env.SCAN_RUN_ID?.trim()) {
                    sh '''set +x
                        curl -sf -X PATCH "$ORCHESTRATOR/api/scans/$SCAN_RUN_ID" \\
                          -H "X-API-Key: $SG_API_KEY" -H 'Content-Type: application/json' -d '{"status":"failed"}' || true
                    '''
                }
            }
        }
    }
}
