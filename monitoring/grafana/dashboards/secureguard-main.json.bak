      "panel-200": {
        "kind": "Panel",
        "spec": {
          "id": 200,
          "title": "CVEs Matched & Fixed by AI Engine",
          "description": "Recent CVEs from CVE Intel Engine \u2014 pulled from /cves/recent",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "yesoreyeram-infinity-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "Infinity"
                      },
                      "spec": {
                        "columns": [
                          {
                            "selector": "cve_id",
                            "text": "CVE ID",
                            "type": "string"
                          },
                          {
                            "selector": "severity",
                            "text": "Severity",
                            "type": "string"
                          },
                          {
                            "selector": "cvss_score",
                            "text": "CVSS",
                            "type": "number"
                          },
                          {
                            "selector": "description",
                            "text": "Description",
                            "type": "string"
                          },
                          {
                            "selector": "published_at",
                            "text": "Published",
                            "type": "string"
                          },
                          {
                            "selector": "is_kev",
                            "text": "CISA KEV",
                            "type": "string"
                          },
                          {
                            "selector": "sources",
                            "text": "Source",
                            "type": "string"
                          }
                        ],
                        "computed_columns": [],
                        "filters": [],
                        "format": "table",
                        "parser": "backend",
                        "root_selector": "",
                        "source": "url",
                        "type": "json",
                        "url": "http://sg-cve-intel:8001/cves/recent",
                        "url_options": {
                          "data": "",
                          "headers": [],
                          "method": "GET",
                          "params": []
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "CVSS"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Severity"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "CRITICAL": {
                                "color": "red",
                                "text": "CRITICAL"
                              },
                              "HIGH": {
                                "color": "orange",
                                "text": "HIGH"
                              },
                              "MEDIUM": {
                                "color": "yellow",
                                "text": "MEDIUM"
                              },
                              "LOW": {
                                "color": "green",
                                "text": "LOW"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "CVSS"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 1
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": 0,
                              "color": "green"
                            },
                            {
                              "value": 7,
                              "color": "orange"
                            },
                            {
                              "value": 9,
                              "color": "red"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "CISA KEV"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "true": {
                                "color": "red",
                                "text": "\u26a0 KEV"
                              },
                              "false": {
                                "color": "green",
                                "text": "No"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Description"
                    },
                    "properties": [
                      {
                        "id": "custom.width",
                        "value": 400
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
