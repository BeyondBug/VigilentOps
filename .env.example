# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=secureguard
POSTGRES_USER=sgadmin
POSTGRES_PASSWORD=change-me-before-starting
GITEA_DB_NAME=secureguard

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://sg-redis:6379/0

# ── Gitea ─────────────────────────────────────────────────────
GITEA_URL=http://sg-gitea:3000
GITEA_TOKEN=your_gitea_personal_access_token
GITEA_WEBHOOK_SECRET=change-me-before-starting
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_ALLOWED_HOSTS=sg-gitea,gitea,localhost
SG_API_KEY=replace-with-a-long-random-value
JENKINS_HOME_HOST=

# ── Service credentials ───────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-starting
WAZUH_USER=wazuh
WAZUH_PASSWORD=change-me-before-starting

# ── AI Engine — Dynamic Multi-Model Fallback ──────────────────────────
# You can define up to 9 models. The Orchestrator will automatically cascade 
# through them sequentially if it encounters 429 Rate Limits or 503 Outages.
MODEL_1=gemini-3.6-flash
API_KEY_1=
API_URL_1=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

MODEL_2=openai/gpt-oss-20b
API_KEY_2=nvapi-your-second-key
API_URL_2=https://integrate.api.nvidia.com/v1/chat/completions

MODEL_3=poolside/laguna-xs-2.1
API_KEY_3=nvapi-your-third-key
API_URL_3=https://integrate.api.nvidia.com/v1/chat/completions

MODEL_4=nvidia/nemotron-3-ultra-550b-a55b
API_KEY_4=nvapi-your-fourth-key
API_URL_4=https://integrate.api.nvidia.com/v1/chat/completions

MODEL_5=moonshotai/kimi-k3
API_KEY_5=nvapi-your-fifth-key
API_URL_5=https://integrate.api.nvidia.com/v1/chat/completions

# ── NIST NVD ──────────────────────────────────────────────────
NVD_API_KEY=your_nvd_api_key_here

# ── Notifications — fill in to enable ────────────────────────
SLACK_WEBHOOK_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
