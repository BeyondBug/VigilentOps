# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=secureguard
POSTGRES_USER=sgadmin
POSTGRES_PASSWORD=change-me-before-starting
GITEA_DB_NAME=secureguard

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://sg-redis:6379/0

# ── Gitea ─────────────────────────────────────────────────────
GITEA_URL=http://sg-gitea:3000
GITEA_TOKEN=your_gitea_personal_access_token
# Username owning the private token; grant only needed repository permissions.
GITEA_GIT_USERNAME=secureguard
GITEA_WEBHOOK_SECRET=change-me-before-starting
GITEA_RUNNER_REGISTRATION_TOKEN=
GITEA_ALLOWED_HOSTS=sg-gitea,gitea,localhost
# Browser-facing URL, without a trailing slash. Configure on the Kali server.
PUBLIC_URL=https://localhost:3000
GATEWAY_BIND_ADDRESS=0.0.0.0
# Separate gateway login for the findings dashboard, Jenkins and Prometheus.
# scripts/configure_gateway.py generates these if they are empty.
PROXY_AUTH_USER=secureguard
PROXY_AUTH_PASSWORD=
SG_API_KEY=replace-with-a-long-random-value
SNYK_TOKEN=
JENKINS_HOME_HOST=

# ── Service credentials ───────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-starting
WAZUH_USER=wazuh
WAZUH_PASSWORD=change-me-before-starting

# ── AI Engine ────────────────────────────────────────────────
# off | openrouter | local | hybrid. Never send repository files to a
# provider unless you configure that mode and its private key.
AI_MODE=off
OPENROUTER_API_KEY=
# Optional subset of the explicit free-model allowlist in model_pool.py.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free,openrouter/free
OLLAMA_URL=http://172.18.0.1:11434/v1/chat/completions
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b
# Account-wide free quotas are shared; changing models does not bypass them.
AI_WORKER_CONCURRENCY=1
AI_MAX_MODEL_ROUTES_PER_FILE=4
AI_MODEL_FAILURE_COOLDOWN_SECONDS=60

# ── NIST NVD ──────────────────────────────────────────────────
NVD_API_KEY=your_nvd_api_key_here
# Optional ODC-compatible feed URL with {0} placeholder. The official
# Dependency-Check mirror is one option when the NVD API is unreliable.
NVD_DATAFEED_URL=
# Optional resolver for scanner containers when Docker's default DNS cannot
# consistently reach NVD, CISA, or other external feeds.
SCANNER_DNS=

# ── Notifications — fill in to enable ────────────────────────
SLACK_WEBHOOK_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+YOUR_NUMBER

JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SG

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ── Internal service URLs ─────────────────────────────────────
REACT_APP_API_URL=
CVE_INTEL_URL=http://sg-cve-intel:8001
ORCHESTRATOR_URL=http://sg-orchestrator:8000
PUSHGATEWAY_URL=http://sg-pushgateway:9091
