# ==========================================
# VigilentOps Environment Variables Example
# ==========================================
# Copy this file to .env and update the values.

# ------------------------------
# PostgreSQL Database
# ------------------------------
POSTGRES_DB=secureguard
POSTGRES_USER=sgadmin
POSTGRES_PASSWORD=sgpassword123

# ------------------------------
# AI Remediation Engine (NVIDIA NIM)
# ------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
SECONDARY_MODEL=meta/llama-3.1-8b-instruct
FALLBACK_MODEL=nvidia/kimi-k2

# ------------------------------
# Gitea Integration
# ------------------------------
GITEA_URL=http://gitea:3000
GITEA_TOKEN=your_gitea_personal_access_token
GITEA_WEBHOOK_SECRET=your_gitea_webhook_secret

# ------------------------------
# CVE Intelligence (NVD)
# ------------------------------
# Highly recommended to get an API key from https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here
POLL_INTERVAL_HOURS=2

# ------------------------------
# Notifications (Optional)
# ------------------------------
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@example.com

# ------------------------------
# Internal Services / Wazuh
# ------------------------------
# These usually don't need to be changed if running in docker-compose
REDIS_URL=redis://redis:6379/0
CVE_INTEL_URL=http://sg-cve-intel:8001
PUSHGATEWAY_URL=http://sg-pushgateway:9091
WAZUH_URL=https://sg-wazuh:55000
WAZUH_USER=wazuh
WAZUH_PASS=wazuh
